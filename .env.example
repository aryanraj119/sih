# URJADRISHTI Environment Configuration

# Demo Mode (Set to true to use reproducible deterministic synthetic Delhi grid data)
DEMO_MODE=true

# Backend API Configuration
BACKEND_URL=http://localhost:8000
API_VERSION=v1

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Meteorological & External Data Integrations (for live mode)
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Delhi Grid SLDC Feeds
LOAD_DATA_URL=https://delhisldc.org/api/load
SOLAR_DATA_URL=https://solargrid.delhi.gov.in/api

# Database Storage
DATABASE_URL=sqlite:///./urjadrishti.db
